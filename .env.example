# TRACE — Financial Crime Network Investigator Environment Configuration

# Maximum real Kaggle CSV records to sample during chunked startup scan
TRACE_MAX_ROWS=6000

# Optional Grounded LLM Narrative Provider (Deterministic Evidence Engine runs automatically if blank)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional Frontend API Base Override (Vite dev proxy forwards /api -> http://127.0.0.1:8000 by default)
VITE_API_BASE=/api

